# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The suite runs against ANY WordPress site that has ThinkRank Free + Pro
# active. Point it at a different site by changing WP_URL — nothing else.

# Target site under test (local, staging, or production)
WP_URL=https://thinkrank.test

# WordPress admin credentials (used to log in and save the test session)
WP_ADMIN_USER=admin
WP_ADMIN_PASS=your-admin-password-here
