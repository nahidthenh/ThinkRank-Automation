# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The suite runs against ANY WordPress site that has ThinkRank Free + Pro
# active. Point it at a different site by changing WP_URL — nothing else.

# Target site under test (local, staging, or production)
WP_URL=https://thinkrank.test

# WordPress admin credentials (used to log in and save the test session)
WP_ADMIN_USER=admin
WP_ADMIN_PASS=your-admin-password-here

# Slack notifications (optional — leave blank to disable).
# The Slack reporter is only enabled when SLACK_BOT_TOKEN is set.
#   SLACK_BOT_TOKEN  — a Slack bot token (xoxb-…) with chat:write
#   SLACK_CHANNEL_ID — the channel ID to post results to (e.g. C0123ABCD)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
